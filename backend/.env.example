PORT=3001

# URL de tu app de React en desarrollo, para permitir CORS
FRONTEND_URL=http://localhost:5173

# Supabase (Settings > API en tu proyecto)
SUPABASE_URL=
# service_role key: tiene permisos totales, salta RLS. Va SOLO acá, nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=
# anon key: se usa para validar el JWT del usuario logueado
SUPABASE_ANON_KEY=

# OpenRouter (la misma cuenta que ya tenés, con saldo)
OPENROUTER_API_KEY=
