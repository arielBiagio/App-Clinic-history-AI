# Set in Supabase Edge Functions secrets, never in VITE_*.
# SUPABASE_URL and SUPABASE_ANON_KEY are provided by Supabase.
MCP_RESOURCE_URL=https://PROJECT_REF.supabase.co/functions/v1/clinical-mcp
# OAuth client ID(s) registered with YOUR Supabase Auth server. Empty denies all.
MCP_ALLOWED_CLIENT_IDS=
# Exact browser origins if required by the client, comma-separated. No wildcard.
# Server-to-server calls without Origin work without entries.
MCP_ALLOWED_ORIGINS=
