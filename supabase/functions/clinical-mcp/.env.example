# Set in Supabase Edge Functions secrets, never in VITE_*.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase.
# Service role is ONLY for Auth OAuth client metadata, never clinical queries.
MCP_RESOURCE_URL=https://PROJECT_REF.supabase.co/functions/v1/clinical-mcp
# Explicit OAuth client ID(s), comma-separated. Alternative to the strict DCR policy below.
MCP_ALLOWED_CLIENT_IDS=
# Optional exact HTTPS callback(s) for dynamic public OAuth clients (one callback per client).
# Empty disables DCR acceptance. No wildcard, prefix, extra URI, name or logo matching.
# Sesame mobile: https://sesameai.app/api/oauth/external-mcp/callback
MCP_TRUSTED_PUBLIC_REDIRECT_URIS=
# Exact browser origins if required by the client, comma-separated. No wildcard.
# Server-to-server calls without Origin work without entries.
MCP_ALLOWED_ORIGINS=
